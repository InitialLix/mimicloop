    "generate:nce3-expressions": "node scripts/generate-nce3-expression-expansion.mjs",
    "approve:nce3": "node scripts/approve-nce3-candidates.mjs",
    "approve:nce3-expanded": "node scripts/approve-nce3-candidates.mjs 29-59",
    "approve:nce3-expressions": "node scripts/approve-nce3-expression-expansion.mjs",
