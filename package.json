{
  "name": "mimicloop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first IELTS Task 2 sentence imitation and transfer trainer",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:candidates": "node scripts/generate-simon-candidates.mjs",
    "generate:calibration": "node scripts/generate-simon-calibration-candidates.mjs",
    "generate:batch-02": "node scripts/generate-simon-batch-02-candidates.mjs",
    "generate:batch-03": "node scripts/generate-simon-batch-03-candidates.mjs",
    "generate:batch-04": "node scripts/generate-simon-batch-04-candidates.mjs",
    "generate:batch-05": "node scripts/generate-simon-batch-05-candidates.mjs",
    "generate:collocations": "node scripts/extract-collocations.mjs",
