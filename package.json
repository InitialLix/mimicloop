    "fix:prompt-hints": "node scripts/fix-guided-prompt-hint-duplication.mjs",
    "approve:collocations": "node scripts/approve-all-collocations.mjs",
    "audit:collocation-scope": "node scripts/audit-collocation-scope.mjs",
    "apply:use-prompts": "node scripts/apply-use-prompt-candidates.mjs",
    "apply:collocation-use-prompts": "node scripts/apply-collocation-use-prompt-candidates.mjs",
    "approve:collocation-use-prompts": "node scripts/approve-all-collocation-use-prompts.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test:schemas": "node scripts/validate-content.mjs --fixtures",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run tests/integration",
    "test:rules": "vitest run tests/unit",
    "eval:use-gold": "tsx scripts/run-use-evaluator-gold.ts",
    "test": "npm run test:schemas && npm run test:rules && npm run test:db"
