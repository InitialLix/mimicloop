    "repair:collocation-target-surface": "node scripts/repair-collocation-target-surface.mjs",
    "generate:collocation-use-prompts": "node scripts/generate-collocation-use-prompt-candidates.mjs",
    "import:nce3": "node scripts/import-nce3-lessons.mjs",
    "generate:nce3": "node scripts/generate-nce3-candidates.mjs",
