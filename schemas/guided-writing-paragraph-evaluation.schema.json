{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimicloop.local/schemas/guided-writing-paragraph-evaluation.schema.json",
  "title": "MimicLoop Guided Writing Paragraph Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "draft_id", "logic", "language", "confidence", "needs_review"
  ],
  "properties": {
    "schema_version": {"const": "guided-writing-paragraph-evaluation.v1"},
    "draft_id": {"$ref": "https://mimicloop.local/schemas/common.schema.json#/$defs/uuid"},
    "logic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "strength_en", "issue_type", "evidence_span", "feedback_en"],
      "properties": {
        "status": {"enum": ["clear", "needs_revision", "cannot_judge"]},
        "strength_en": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 220}, {"type": "null"}]},
        "issue_type": {
          "oneOf": [
            {"enum": ["off_task", "missing_main_point", "missing_support", "missing_development", "unsupported_jump", "list_without_development", "overclaim", "progression", "repetition", "weak_connection", "takeaway_repetition", "contradiction"]},
            {"type": "null"}
          ]
        },
        "evidence_span": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 600}, {"type": "null"}]},
        "feedback_en": {"type": "string", "minLength": 1, "maxLength": 280}
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "strength_en", "issue_type", "severity", "evidence_span", "feedback_en"],
      "properties": {
        "status": {"enum": ["clear", "needs_revision", "cannot_judge"]},
        "strength_en": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 220}, {"type": "null"}]},
        "issue_type": {
          "oneOf": [
            {"enum": ["meaning_unclear", "grammar", "spelling", "collocation", "word_choice", "cohesion", "sentence_combination", "register", "sentence_boundary"]},
            {"type": "null"}
          ]
        },
        "severity": {"oneOf": [{"enum": ["minor", "blocking"]}, {"type": "null"}]},
        "evidence_span": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 600}, {"type": "null"}]},
        "feedback_en": {"type": "string", "minLength": 1, "maxLength": 280}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_review": {"type": "boolean"}
  }
}
