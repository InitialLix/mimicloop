{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimicloop.local/schemas/candidate-card.schema.json",
  "title": "MimicLoop Candidate Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "card",
    "source_match",
    "selection_scores",
    "recommendation_reasons",
    "uncertainties",
    "workflow_status",
    "priority",
    "provenance",
    "review_history",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://mimicloop.local/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "candidate_id": {
      "$ref": "https://mimicloop.local/schemas/common.schema.json#/$defs/uuid"
    },
    "card": {
      "$ref": "https://mimicloop.local/schemas/sentence-card.schema.json"
    },
    "source_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_type", "matched_text", "paragraph_index", "sentence_index"],
      "properties": {
        "match_type": {
          "type": "string",
          "enum": ["exact", "normalized_formatting", "unverified"]
        },
        "matched_text": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "paragraph_index": {
          "type": "integer",
          "minimum": 0
        },
        "sentence_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selection_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naturalness", "context_independence", "vocabulary_value", "structure_value", "transfer_value"],
      "properties": {
        "naturalness": {"type": "integer", "minimum": 1, "maximum": 5},
        "context_independence": {"type": "integer", "minimum": 1, "maximum": 5},
        "vocabulary_value": {"type": "integer", "minimum": 1, "maximum": 5},
        "structure_value": {"type": "integer", "minimum": 1, "maximum": 5},
        "transfer_value": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "recommendation_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "uncertainties": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "workflow_status": {
      "type": "string",
      "enum": ["candidate", "needs_edit", "approved", "deferred", "rejected"]
    },
    "priority": {
      "type": "string",
      "enum": ["core", "supporting"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guideline_version", "prompt_version", "processor_type", "model_id"],
      "properties": {
        "guideline_version": {"type": "string", "const": "1.0.0"},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "processor_type": {
          "type": "string",
          "enum": ["codex", "manual", "external_llm"]
        },
        "model_id": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 200},
            {"type": "null"}
          ]
        }
      }
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "reviewer", "reason", "reviewed_at"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["created", "marked_needs_edit", "edited", "approved", "deferred", "rejected"]
          },
          "reviewer": {"type": "string", "minLength": 1, "maxLength": 200},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
          "reviewed_at": {
            "$ref": "https://mimicloop.local/schemas/common.schema.json#/$defs/dateTime"
          }
        }
      }
    },
    "created_at": {
      "$ref": "https://mimicloop.local/schemas/common.schema.json#/$defs/dateTime"
    },
    "updated_at": {
      "$ref": "https://mimicloop.local/schemas/common.schema.json#/$defs/dateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"workflow_status": {"const": "approved"}},
        "required": ["workflow_status"]
      },
      "then": {
        "properties": {"review_history": {"type": "array", "minItems": 1}}
      }
    }
  ]
}
