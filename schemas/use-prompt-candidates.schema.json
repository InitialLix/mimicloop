{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimicloop.local/schemas/use-prompt-candidates.schema.json",
  "title": "Use Prompt Candidate Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "items"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "generated_at": {"$ref": "https://mimicloop.local/schemas/common.schema.json#/$defs/dateTime"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "mode", "prompt_zh", "hints", "target_chunk", "reference_answer", "feedback_pattern", "review_status"],
        "properties": {
          "card_id": {"type": "string", "format": "uuid"},
          "mode": {"enum": ["structure", "vocabulary"]},
          "prompt_zh": {"type": "string", "minLength": 1, "maxLength": 1000},
          "hints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["zh", "en"],
              "properties": {
                "zh": {"type": "string", "minLength": 1, "maxLength": 100},
                "en": {"type": "string", "minLength": 1, "maxLength": 200}
              }
            }
          },
          "target_chunk": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
          "reference_answer": {"type": "string", "minLength": 10, "maxLength": 2000},
          "feedback_pattern": {"type": ["string", "null"], "minLength": 10, "maxLength": 2000},
          "review_status": {"enum": ["candidate", "approved", "needs_edit", "rejected"]}
        },
        "allOf": [
          {
            "if": {"properties": {"mode": {"const": "vocabulary"}}, "required": ["mode"]},
            "then": {"properties": {"target_chunk": {"type": "string", "minLength": 1}, "feedback_pattern": {"type": "null"}}}
          },
          {
            "if": {"properties": {"mode": {"const": "structure"}}, "required": ["mode"]},
            "then": {"properties": {"target_chunk": {"type": "null"}, "feedback_pattern": {"type": "string", "minLength": 10, "pattern": "\\{[a-z][a-z0-9_]*\\}"}}}
          }
        ]
      }
    }
  }
}
