# Phase 2.1 remains off by default. Recall and the existing self-review flow need no API key.
MIMICLOOP_USE_EVALUATOR_ENABLED=false
DEEPSEEK_API_KEY=
MIMICLOOP_DEEPSEEK_MODEL=deepseek-v4-flash
MIMICLOOP_AI_TIMEOUT_MS=8000
MIMICLOOP_USE_EVALUATOR_CONFIDENCE=0.65
# Phase 2.5B English idea-and-argument coaching. If omitted, it follows the existing AI switch above.
MIMICLOOP_GUIDED_WRITING_ENABLED=false
# Phase 2.4 deterministic next-step policy. No additional model call or API cost.
MIMICLOOP_ADAPTIVE_NEXT_STEP_ENABLED=false

# Short-lived judge link. Leave off for the original local single-user mode.
MIMICLOOP_COMPETITION_MODE=false
MIMICLOOP_COMPETITION_DATA_ROOT=
MIMICLOOP_SESSION_SIGNING_SECRET=
MIMICLOOP_AI_CALLS_PER_SESSION_HOUR=100
MIMICLOOP_AI_CALLS_GLOBAL_HOUR=500
